
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Premium Payment Verification</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;padding:25px 15px;
  font-family:Arial,sans-serif;
  background:#0b1220;color:white;
}
.card{
  max-width:420px;margin:40px auto;
  padding:25px;background:#151f32;
  border:1px solid #263b58;
  border-radius:18px;
}
h2{text-align:center;color:#45a3ff}
p{text-align:center;color:#aebbd0}
input{
  width:100%;padding:15px;margin:10px 0;
  border:1px solid #344863;border-radius:10px;
  background:#0b1220;color:white;font-size:16px;
}
button{
  width:100%;padding:15px;margin-top:15px;
  border:0;border-radius:10px;
  background:#1877f2;color:white;
  font-size:17px;font-weight:bold;
}
#status{text-align:center;margin-top:15px}
</style>
</head>
<body>

<div class="card">
<h2>Premium Payment</h2>
<p>Submit your payment details</p>

<form id="paymentForm">
<input id="phone" type="tel"
placeholder="Phone Number" required>

<input id="txn" type="text"
placeholder="Transaction Number" required>

<input id="amount" type="number"
placeholder="Amount (ETB)" min="1" step="0.01" required>

<button type="submit">SEND</button>
</form>

<div id="status"></div>
</div>

<script>
const form=document.getElementById("paymentForm");

form.addEventListener("submit",async function(e){
 e.preventDefault();

 const data={
  phone:document.getElementById("phone").value.trim(),
  transaction:document.getElementById("txn").value.trim(),
  amount:document.getElementById("amount").value
 };

 const status=document.getElementById("status");
 const btn=form.querySelector("button");

 btn.disabled=true;
 status.textContent="Sending...";

 try{
  const response=await fetch("/api/payment-request",{
   method:"POST",
   headers:{"Content-Type":"application/json"},
   body:JSON.stringify(data)
  });

  if(!response.ok) throw new Error("Failed");

  status.textContent="Submitted successfully!";
  form.reset();

 }catch(error){
  status.textContent="Could not send. Please try again.";
 }finally{
  btn.disabled=false;
 }
});
</script>

</body>
</html>
