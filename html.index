
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payment Information</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f0f4fa;
  color:#172033;
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:20px;
}
.container{
  width:100%;
  max-width:430px;
  background:white;
  padding:28px 22px;
  border-radius:18px;
  box-shadow:0 8px 30px rgba(0,0,0,.09);
}
.logo{
  text-align:center;
  font-size:28px;
  font-weight:bold;
  color:#1877f2;
  margin-bottom:8px;
}
.subtitle{
  text-align:center;
  color:#687386;
  font-size:14px;
  margin-bottom:25px;
}
label{
  display:block;
  font-weight:bold;
  font-size:14px;
  margin:16px 0 7px;
}
input{
  width:100%;
  padding:14px;
  border:1px solid #d6dce5;
  border-radius:9px;
  font-size:16px;
  outline:none;
}
input:focus{border-color:#1877f2}
button{
  width:100%;
  padding:15px;
  border:0;
  border-radius:9px;
  background:#1877f2;
  color:white;
  font-size:16px;
  font-weight:bold;
  margin-top:22px;
  cursor:pointer;
}
button:active{opacity:.8}
.telegram{
  margin-top:25px;
  padding:17px;
  background:#eef5ff;
  border-radius:12px;
  text-align:center;
}
.telegram p{
  margin:5px 0 12px;
  font-size:14px;
  color:#526174;
}
.username{
  color:#1877f2;
  font-weight:bold;
  font-size:18px;
}
.copybtn{
  background:#229ed9;
  margin-top:12px;
  padding:11px;
  font-size:14px;
}
#message{
  display:none;
  margin-top:16px;
  padding:13px;
  background:#e8f7ed;
  color:#176b35;
  border-radius:9px;
  font-size:14px;
  line-height:1.6;
}
.footer{
  text-align:center;
  color:#8a93a2;
  font-size:12px;
  margin-top:22px;
}
</style>
</head>
<body>

<div class="container">
  <div class="logo">Payment Information</div>
  <div class="subtitle">Enter your payment details below</div>

  <form id="paymentForm">
    <label for="phone">Phone Number</label>
    <input id="phone" type="tel"
      placeholder="Enter your phone number"
      required>

    <label for="reference">Reference Number</label>
    <input id="reference" type="text"
      placeholder="Enter reference number"
      required>

    <label for="amount">Amount (ETB)</label>
    <input id="amount" type="number"
      placeholder="Enter amount"
      min="0.01" step="0.01" required>

    <button type="submit">SEND</button>
  </form>

  <div id="message" role="status"></div>

  <div class="telegram">
    <p>Send your copied information on Telegram</p>
    <div class="username">@Cj_Fresh281</div>
    <button class="copybtn" type="button"
      id="copyUsername">Copy Telegram Username</button>
  </div>

  <div class="footer">
    Secure payment information submission
  </div>
</div>

<script>
const form = document.getElementById("paymentForm");
const message = document.getElementById("message");

async function copyText(text) {
  if (navigator.clipboard && window.isSecureContext) {
    await navigator.clipboard.writeText(text);
    return true;
  }

  const area = document.createElement("textarea");
  area.value = text;
  area.style.position = "fixed";
  area.style.left = "-9999px";
  document.body.appendChild(area);
  area.select();

  const success = document.execCommand("copy");
  area.remove();
  return success;
}

form.addEventListener("submit", async function(e) {
  e.preventDefault();

  const phone = document.getElementById("phone").value.trim();
  const reference = document.getElementById("reference").value.trim();
  const amount = document.getElementById("amount").value;

  if (!phone || !reference || !amount || Number(amount) <= 0) {
    message.style.display = "block";
    message.textContent = "Please enter all details correctly.";
    return;
  }

  const details =
`PAYMENT INFORMATION
Phone Number: ${phone}
Reference Number: ${reference}
Amount: ${Number(amount).toFixed(2)} ETB`;

  try {
    const copied = await copyText(details);

    message.style.display = "block";

    if (copied) {
      message.innerHTML =
        "Details copied successfully!<br>" +
        "Now open Telegram, search <b>@Cj_Fresh281</b>, " +
        "paste your details and send them.";
    } else {
      message.textContent =
        "Copy was not successful. Please try again.";
    }
  } catch (error) {
    message.style.display = "block";
    message.textContent =
      "Copy failed. Please try again.";
  }
});

document.getElementById("copyUsername")
.addEventListener("click", async function() {
  try {
    const copied = await copyText("@Cj_Fresh281");
    message.style.display = "block";
    message.textContent = copied
      ? "Telegram username copied!"
      : "Could not copy username.";
  } catch (error) {
    message.style.display = "block";
    message.textContent = "Could not copy username.";
  }
});
</script>

</body>
</html>
