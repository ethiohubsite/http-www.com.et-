

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payment Information</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#eef2f8;
  color:#17243a;
}
header{
  background:#1769d2;
  color:white;
  text-align:center;
  padding:22px 15px;
}
header h2{margin:0;font-size:24px}
header p{font-size:13px;margin:7px 0 0}
.container{max-width:440px;margin:25px auto;padding:0 14px}
.card{
  background:white;
  padding:23px 19px;
  border-radius:16px;
  box-shadow:0 5px 22px #00000012;
}
h3{margin:0 0 8px;text-align:center}
.subtitle{
  text-align:center;
  font-size:13px;
  color:#778397;
  margin-bottom:22px;
}
label{
  display:block;
  font-size:13px;
  font-weight:bold;
  margin:15px 0 7px;
}
input{
  width:100%;
  padding:14px;
  border:1px solid #d9e0eb;
  border-radius:9px;
  font-size:15px;
}
input:focus{outline:1px solid #1769d2}
button{
  width:100%;
  padding:15px;
  margin-top:22px;
  border:0;
  border-radius:9px;
  background:#1769d2;
  color:white;
  font-size:16px;
  font-weight:bold;
}
.telegram{
  margin-top:18px;
  padding:15px;
  background:#eaf4ff;
  border-radius:10px;
  text-align:center;
}
.telegram a{
  color:#0875c9;
  font-weight:bold;
  text-decoration:none;
}
#message{
  font-size:13px;
  text-align:center;
  line-height:1.6;
  margin-top:13px;
}
footer{
  text-align:center;
  color:#8792a3;
  font-size:11px;
  padding:20px;
}
</style>
</head>
<body>

<header>
  <h2>Payment Information</h2>
  <p>Please enter your transaction details</p>
</header>

<div class="container">
<div class="card">

<h3>ይግቡ</h3>
<p class="subtitle">እባክዎ መረጃዎን ይሙሉ</p>

<form id="paymentForm">

<label>1. Phone Number</label>
<input id="phone" type="tel"
placeholder="09XXXXXXXX" required>

<label>2. Reference Number</label>
<input id="reference" type="text"
placeholder="Enter Reference Number" required>

<label>3. Amount (ETB)</label>
<input id="amount" type="number"
min="0.01" step="0.01"
placeholder="Enter Amount" required>

<button type="submit">SEND</button>
</form>

<div id="message"></div>

<div class="telegram">
  <p>Contact us on Telegram</p>
  <a href="https://t.me/Cj_Fresh281"
     target="_blank">@Cj_Fresh281</a>
</div>

</div>
</div>

<footer>© 2026 Payment Information</footer>

<script>
document.getElementById("paymentForm")
.addEventListener("submit",async function(e){

e.preventDefault();

const phone=document.getElementById("phone").value.trim();
const reference=document.getElementById("reference").value.trim();
const amount=document.getElementById("amount").value;

if(!phone||!reference||!amount||Number(amount)<=0){
  document.getElementById("message").textContent=
  "Please complete all fields correctly.";
  return;
}

const details=
"Payment Information\n"+
"Phone: "+phone+"\n"+
"Reference: "+reference+"\n"+
"Amount: "+amount+" ETB";

try{
  await navigator.clipboard.writeText(details);
  document.getElementById("message").innerHTML=
  "Details copied! Open Telegram and send the copied information to @Cj_Fresh281.";
}catch(error){
  document.getElementById("message").textContent=
  "Please copy your details and send them to @Cj_Fresh281 on Telegram.";
}

});
</script>
</body>
</html>
